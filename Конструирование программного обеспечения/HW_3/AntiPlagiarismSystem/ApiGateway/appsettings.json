{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "storage": {
        "ClusterId": "storage-cluster",
        "Match": {
          "Path": "/storage/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/storage"
          }
        ]
      },
      "analysis": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/analysis/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/analysis"
          }
        ]
      }
    },
    "Clusters": {
      "storage-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://storage:8080/"
          }
        }
      },
      "analysis-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://analysis:80/"
          }
        }
      }
    }
  }
}